{
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://agento.biz/api/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://agento.biz/_next/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}